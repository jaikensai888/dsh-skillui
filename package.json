{
  "name": "dsh-skillui",
  "version": "0.1.0",
  "description": "A DSH plugin that adds a sibling Skill UI tab to dsh-better-sidebar.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./protocol": {
      "types": "./lib/types/shared/protocol.d.ts",
      "default": "./lib/shared/protocol.js"
    }
  },
  "files": [
    "lib",
    "views",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run declarations && tsdown",
    "clean": "node -e \"import('node:fs/promises').then(({rm}) => rm('lib', {recursive:true, force:true}))\"",
    "declarations": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc.1",
    "dsh-better-sidebar": ">=0.16.1",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dsh-better-sidebar": "0.16.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.15.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.19.0"
}
